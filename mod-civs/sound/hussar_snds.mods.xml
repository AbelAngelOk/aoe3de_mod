<!--
  mod-minimal (Caballeros Hospitalarios): el Húsar real (Hussar) tiene <civlogic> en
  Sound/hussar_snds.xml y "HOSHospitalarios" no existe ahí (civ nueva) -> quedaba mudo.
  Reusa el mismo soundset que ya usa DEMaltese real para su propio Húsar (prestado de
  Hungría: DEHungarianHussarSelect/Acknowledge/Attack), copiado como MM.
-->
<protounitsounddefmods>
  <protounit name="Hussar">
    <soundtype name="Select">
      <civlogic>
        <choice name="HOSHospitalarios">
          <soundset name="MMDEHungarianHussarSelect">
          </soundset>
        </choice>
        <choice name="CHLChile">
          <soundset name="MMSpanishLightCavalrySelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="HOSHospitalarios">
          <targetlogic>
            <choice name="default">
              <soundset name="MMDEHungarianHussarAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMDEHungarianHussarAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
        <choice name="CHLChile">
          <targetlogic>
            <choice name="default">
              <soundset name="MMSpanishLightCavalryAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMSpanishLightCavalryAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
