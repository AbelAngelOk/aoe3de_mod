<!--
  mod-minimal (Argentina): voz del espía (xpSpy real — Italia lo habilita/usa en
  DEAge0Italians). Proto COMPARTIDO; su sonido se resuelve por <civlogic> en
  Sound/xpspy_snds.xml y "ARGArgentina" no existe ahí (civ nueva) -> quedaba mudo. Archivo
  ADITIVO que agrega la rama ARGArgentina reusando los soundsets reales "Spanish"
  (SpanishLightCavalry*, pedido explícito: sonido de los espías españoles).
-->
<protounitsounddefmods>
  <protounit name="xpSpy">
    <soundtype name="Select">
      <civlogic>
        <choice name="ARGArgentina">
          <soundset name="MMSpanishLightCavalrySelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="ARGArgentina">
          <targetlogic>
            <choice name="default">
              <soundset name="MMSpanishLightCavalryAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMSpanishLightCavalryAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
