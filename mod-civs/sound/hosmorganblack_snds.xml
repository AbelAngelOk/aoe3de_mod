<!--
  mod-minimal (Caballeros Hospitalarios): voz de "Morgan Black" (HOSMorganBlack, clon de
  deGrandMaster). El deGrandMaster real YA tiene un skin "0" = Morgan Black con soundsets
  reales dedicados (MorganBlackSelect/Grunt/Death/Acknowledge/Attack/Revive, ver
  degrandmaster_snds.xml) — como el clon está FIJO en ese personaje (sin variantes de piel),
  el archivo va plano sin <skinlogic>, apuntando directo a esos soundsets reales.
-->
<protounitsounddef>
  <protounit name="HOSMorganBlack">
    <soundtype name="Select">
      <soundset name="MorganBlackSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="MorganBlackGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="MorganBlackDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="MorganBlackAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="MorganBlackAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
    <soundtype name="KnockOut">
      <soundset name="MorganBlackDeath">
      </soundset>
    </soundtype>
    <soundtype name="KnockOutRevived">
      <soundset name="MorganBlackRevive">
      </soundset>
    </soundtype>
    <soundtype name="Ransomed">
      <soundset name="MorganBlackSelect">
      </soundset>
    </soundtype>
  </protounit>
</protounitsounddef>
