<!--
  mod-minimal (Finlandia): voz propia del Jaeger de Carelia (proto FINKarelianJaeger). El
  archivo original estaba clonado de un Guerrillero real (civlogic con una entrada por civ
  europea) y no incluía "DEFinnish", por lo que la civ quedaba sin ningún sonido asignado.
  Se simplifica a una estructura plana (igual que hunhonved_snds.xml) reusando el soundset
  "FinnishHakkapeliittas", que el propio archivo original ya usaba para cuando Suecia entrena
  Guerrilleros (DESwedish/Russians), así que encaja igual de bien para la civ finlandesa.
-->
<protounitsounddef>
  <protounit name="FINKarelianJaeger">
    <soundtype name="Select">
      <soundset name="FinnishHakkapeliittasSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="FinnishHakkapeliittasAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="FinnishHakkapeliittasAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
