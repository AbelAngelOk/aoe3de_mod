<!--
  mod-minimal (Colombia): el Mosquetero real (Musketeer) tiene <civlogic> en
  Sound/musketeer_snds.xml y "COLColombia" no existe ahí (civ nueva) -> quedaba mudo.
  Reusa el mismo soundset que ya usa la rama "Spanish" real (SpanishMusketeerSelect/etc.),
  copiado como MM.
-->
<protounitsounddefmods>
  <protounit name="Musketeer">
    <soundtype name="Select">
      <civlogic>
        <choice name="COLColombia">
          <soundset name="MMSpanishMusketeerSelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="COLColombia">
          <targetlogic>
            <choice name="default">
              <soundset name="MMSpanishMusketeerAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMSpanishMusketeerAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
