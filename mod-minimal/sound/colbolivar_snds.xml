<!--
  mod-minimal (Colombia): voz de "Simón Bolívar" (COLBolivar, clon del Explorador real). El
  real deREVBolivar tiene soundsets propios dedicados (Bolivar*, universales sin civlogic) —
  se reusan directo, plano.
-->
<protounitsounddef>
  <protounit name="COLBolivar">
    <soundtype name="Select">
      <soundset name="BolivarSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="BolivarGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="BolivarDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="BolivarAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="BolivarAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
    <soundtype name="KnockOutRevived">
      <soundset name="BolivarRevive">
      </soundset>
    </soundtype>
  </protounit>
</protounitsounddef>
