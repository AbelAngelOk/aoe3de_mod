<!--
  mod-minimal (Caballeros Hospitalarios): voz del Highlander propio (HOSHighlander, clon de
  MercHighlander). El real MercHighlander es universal (sin civlogic) — se reusan los mismos
  soundsets reales directo, plano, mismo patrón que hunpandur_snds.xml/hungrenzer_snds.xml.
-->
<protounitsounddef>
  <protounit name="HOSHighlander">
    <soundtype name="Select">
      <soundset name="ScottishHighlanderSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="ScottishHighlanderAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="ScottishHighlanderAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
