<material>
  <submaterial name="mata">
    <materialdef name="default_doublesided_cutout">
    </materialdef>
    <parameters>
      <texture name="BaseColor" override="units\mercenaries\fusilier\textures\fusilier_gun_mata_basecolor">
      </texture>
      <texture name="Normals" override="units\mercenaries\fusilier\textures\fusilier_gun_mata_normals">
      </texture>
      <texture name="Masks" override="units\mercenaries\fusilier\textures\fusilier_gun_mata_masks">
      </texture>
      <float name="Metallic Max" override="1.0000">
      </float>
      <float name="Roughness Max" override="1.0000">
      </float>
      <float name="Roughness Min" override="0.0000">
      </float>
      <float name="Roughness Metallic Min" override="0.4000">
      </float>
      <float name="Roughness Metallic Max" override="1.0000">
      </float>
      <float name="Lift Metallic" override="0.0000">
      </float>
      <float name="Lift Non-Metallic" override="0.0000">
      </float>
      <float name="Metallic Min" override="0.0000">
      </float>
    </parameters>
