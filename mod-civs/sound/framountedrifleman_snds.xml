<!--
  mod-minimal (Francia Napoleónica): voz del Fusilero Montado propio (FRAMountedRifleman,
  clon de deMercMountedRifleman real). El real usa soundsets universales sin civlogic
  (FrenchSkirmisher*) — se reusan directo, plano, mismo patrón que barpirate_snds.xml.
-->
<protounitsounddef>
  <protounit name="FRAMountedRifleman">
    <soundtype name="Select">
      <soundset name="FrenchSkirmisherSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="CavalryGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="FrenchSkirmisherAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="FrenchSkirmisherAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
