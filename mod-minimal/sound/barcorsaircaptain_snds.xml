<!--
  mod-minimal (Estados Berberiscos): voz de "Capitán Corsario" (BARCorsairCaptain, clon del
  Explorador real). El real deREVCorsairCaptain (mismo personaje base, Oruç Reis) usa
  soundsets "Sahin*" — ya registrados como MMSahin* por Egipto (docs/civs/04-egipto.md) — se
  reusan directo sin copiar wavs nuevos. Sin MMSahinDeath registrado: se usa el genérico.
-->
<protounitsounddef>
  <protounit name="BARCorsairCaptain">
    <soundtype name="Select">
      <soundset name="MMSahinSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="MMSahinGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="MMSahinAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="MMSahinAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
    <soundtype name="KnockOutRevived">
      <soundset name="MMSahinRevive">
      </soundset>
    </soundtype>
  </protounit>
</protounitsounddef>
