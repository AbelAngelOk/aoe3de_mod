<!--
  mod-minimal (Indias Orientales Neerlandesas): el Cetbang (deREVCetbang, proto real de la
  revolución de Indonesia) solo tiene ramas "Dutch" y "Portuguese" en
  Sound/derevcetbang_snds.xml -> "IORDutchEastIndies" (civ nueva) quedaba mudo. Reusa la voz de
  la rama Portuguese (base real de esta civ) vía soundsets MM registrados en
  soundsetsde.mods.xml (mm\portuguesefalconet*.wav).
-->
<protounitsounddefmods>
  <protounit name="deREVCetbang">
    <soundtype name="Select">
      <civlogic>
        <choice name="IORDutchEastIndies">
          <soundset name="MMPortugueseFalconetSelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="IORDutchEastIndies">
          <targetlogic>
            <choice name="default">
              <soundset name="MMPortugueseFalconetAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMPortugueseFalconetAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
