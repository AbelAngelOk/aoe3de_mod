<!--
  mod-minimal (Chile): el Dragón real (Dragoon) tiene <civlogic> en Sound/dragoon_snds.xml y
  "CHLChile" no existe ahí (civ nueva) -> quedaba mudo. Reusa el mismo soundset que ya usa la
  rama "Spanish" real (SpanishDragoonSelect/etc.) — ya registrado como MM por Colombia.
-->
<protounitsounddefmods>
  <protounit name="Dragoon">
    <soundtype name="Select">
      <civlogic>
        <choice name="CHLChile">
          <soundset name="MMSpanishDragoonSelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="CHLChile">
          <targetlogic>
            <choice name="default">
              <soundset name="MMSpanishDragoonAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMSpanishDragoonAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
