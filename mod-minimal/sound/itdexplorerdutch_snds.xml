<protounitsounddef>
  <protounit name="ITDExplorerDutch">
    <soundtype name="Select">
      <soundset name="DutchExplorerSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="SettlerBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="DutchExplorerAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="DutchExplorerAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
    <soundtype name="Claim">
      <soundset name="DutchExplorerClaim">
      </soundset>
    </soundtype>
    <soundtype name="KnockOut">
      <soundset name="DutchExplorerDisabled">
      </soundset>
    </soundtype>
    <soundtype name="Ransomed">
      <soundset name="DutchExplorerRansomed">
      </soundset>
    </soundtype>
    <soundtype name="KnockOutRevived">
      <soundset name="DutchExplorerRevived">
      </soundset>
    </soundtype>
  </protounit>
</protounitsounddef>
