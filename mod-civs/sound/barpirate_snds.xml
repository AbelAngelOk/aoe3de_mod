<!--
  mod-minimal (Estados Berberiscos): voz del Pirata propio (BARPirate, clon de SaloonPirate).
  El real usa <techlogic> con fallback "none" = BarbaryCorsairSelect/Acknowledge/Attack
  (soundset universal, sin depender de ninguna civ) — se reusa directo, plano.
-->
<protounitsounddef>
  <protounit name="BARPirate">
    <soundtype name="Select">
      <soundset name="BarbaryCorsairSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="BarbaryCorsairAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="BarbaryCorsairAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
