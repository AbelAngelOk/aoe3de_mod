<!--
  mod-minimal (Argentina): voz del Gaucho (deStateMilitia real, renombrado para Argentina).
  Pedido explícito: usar el sonido de deEmboscador (soundsets reales "DEMexicanSalteador*").

  Intento 1 (descartado): agregar <civlogic> con una rama "ARGArgentina" — el archivo vanilla
  Sound/destatemilitia_snds.xml es COMPLETAMENTE PLANO (sin <civlogic> en absoluto), y el
  motor no lo fusionó (reportado sin sonido tras probarlo en juego). La hipótesis es que el
  merge de _snds.mods.xml necesita un <civlogic> YA EXISTENTE en el soundtype base para
  poder agregarle una rama — sin eso, no tiene dónde "engancharse".

  Intento 2: en vez de agregar civlogic, se SOBREESCRIBE directo el <soundset> plano
  existente (mismo elemento, mismo soundtype, sin civlogic de por medio). Efecto colateral
  aceptado: como deStateMilitia es un proto COMPARTIDO, esto cambia su voz para CUALQUIER civ
  que lo use, no solo Argentina — el usuario permitió este compromiso explícitamente.

  Intento 3 (este archivo, tras confirmar en juego que Colono/Explorador TAMPOCO sonaban con
  un nombre vanilla directo ni agregando una rama a un civlogic YA EXISTENTE — ver
  aoe3-unit-sounds-snds): el soundset de destino debe ser uno registrado por el propio mod,
  nunca un nombre vanilla tal cual, así que se apunta a "MMDEMexicanSalteador*" (registrado en
  soundsetsde.mods.xml, mismos .wav que el soundset vanilla real) en vez de
  "DEMexicanSalteador*" directo.
-->
<protounitsounddefmods>
  <protounit name="deStateMilitia">
    <soundtype name="Select">
      <soundset name="MMDEMexicanSalteadorSelect">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="MMDEMexicanSalteadorAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="MMDEMexicanSalteadorAttack">
          </soundset>
        </choice>
        <choice name="build">
        </choice>
        <choice name="Huntable">
        </choice>
        <choice name="Tree">
        </choice>
        <choice name="AbstractMine">
        </choice>
        <choice name="AbstractFarm">
        </choice>
        <choice name="AbstractResourceCrate">
        </choice>
        <choice name="AbstractFruit">
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
