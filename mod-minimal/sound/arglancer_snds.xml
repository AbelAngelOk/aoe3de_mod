<!--
  mod-minimal (Argentina): voz del clon propio ARGLancer (modelo/ícono del
  deRevolutionaryScout, stats del Lancer real). Proto propio -> sin <civlogic>,
  estructura plana igual que hunhonved_snds.xml. Reusa el soundset real
  "SpanishLancer" (pedido explícito: sonidos de la civilización española).
-->
<protounitsounddef>
  <protounit name="ARGLancer">
    <soundtype name="Select">
      <soundset name="SpanishLancerSelect">
      </soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GenericMaleGrunt">
      </soundset>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GenericMaleDeath">
      </soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth">
      </soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="SpanishLancerAcknowledge">
          </soundset>
        </choice>
        <choice name="enemy">
          <soundset name="SpanishLancerAttack">
          </soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>
