<!--
  mod-minimal (Argentina): voz del Dragoon real, entrenable de forma nativa en el Establo de
  Italia (columna 2, heredado sin cambios vía DEAge0Italians). Proto COMPARTIDO; su sonido se
  resuelve por <civlogic> en Sound/dragoon_snds.xml y "ARGArgentina" no existe ahí (civ nueva)
  -> quedaba mudo. Archivo ADITIVO que agrega la rama ARGArgentina reusando los soundsets
  reales "Spanish" (pedido explícito: sonidos de la civilización española).
-->
<protounitsounddefmods>
  <protounit name="Dragoon">
    <soundtype name="Select">
      <civlogic>
        <choice name="ARGArgentina">
          <soundset name="MMSpanishDragoonSelect">
          </soundset>
        </choice>
      </civlogic>
    </soundtype>
    <soundtype name="Acknowledge">
      <civlogic>
        <choice name="ARGArgentina">
          <targetlogic>
            <choice name="default">
              <soundset name="MMSpanishDragoonAcknowledge">
              </soundset>
            </choice>
            <choice name="enemy">
              <soundset name="MMSpanishDragoonAttack">
              </soundset>
            </choice>
          </targetlogic>
        </choice>
      </civlogic>
    </soundtype>
  </protounit>
</protounitsounddefmods>
